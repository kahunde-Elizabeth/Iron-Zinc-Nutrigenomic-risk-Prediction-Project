# Copy to .env and edit. Do NOT commit .env.
# MinIO CE is archived and no longer publishes images; try this older release first.
# If "docker compose up" cannot pull it, tell me and we switch the backend (code is S3-generic).
S3_IMAGE=quay.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
S3_ACCESS_KEY=izn-admin
S3_SECRET_KEY=com3get!n
S3_ENDPOINT=http://localhost:9000
# Folder on a drive with free space, OUTSIDE the git repo, forward slashes, no spaces
OBJECT_STORE_DIR=D:/izn-object-store
